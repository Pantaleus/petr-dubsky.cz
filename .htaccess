# .htaccess - SEO a Performance optimalizace pro dubsky.it

# === ZÁKLADNÍ NASTAVENÍ ===
Options -Indexes
ServerSignature Off

# Vlastní chybová stránka 404 pro SEO
ErrorDocument 404 /404.php

# === SECURITY HEADERS ===
<IfModule mod_headers.c>
    # Security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.tiny.cloud https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.tiny.cloud; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.tiny.cloud; img-src 'self' data: https://www.google-analytics.com https://sp.tinymce.com https://flagcdn.com; connect-src 'self' https://www.google-analytics.com https://cdn.tiny.cloud;"
    
    # HSTS (HTTP Strict Transport Security) - jen pokud máš SSL
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# === SSL a WWW REDIRECT (optimalizováno) ===
RewriteEngine On

# Kombinovaný redirect (SSL + bez www) v jednom kroku
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://petr-dubsky.cz/$1 [R=301,L]

# === SEO FRIENDLY URLS ===

# Sitemap routing
RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]
RewriteRule ^robots\.txt$ robots.txt [L]

# Blog a Raspberry routing
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog/article.php?slug=$1 [L,QSA]
RewriteRule ^raspberry/([a-zA-Z0-9-]+)/?$ raspberry/article.php?slug=$1 [L,QSA]


# === COMPRESSION ===
<IfModule mod_deflate.c>
    # Komprese textových souborů
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
</IfModule>

# === BROWSER CACHING ===
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    
    # HTML, XML, JSON
    ExpiresByType text/html "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType application/json "access plus 1 day"
    
    # Manifests
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/cache-manifest "access plus 1 week"
</IfModule>

# === ETAG ===
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# === HOTLINK PROTECTION ===
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://(www\.)?petr-dubsky\.cz [NC]
RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\. [NC]
RewriteCond %{HTTP_REFERER} !^https://(www\.)?facebook\. [NC]
RewriteCond %{HTTP_REFERER} !^https://(www\.)?linkedin\. [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F]

# === DENY ACCESS TO SENSITIVE FILES ===
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|conf|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Deny access to specific directories
RedirectMatch 404 ^/(config|includes|tmp|log|vendor|node_modules|\.git)/

# === MIME TYPES ===
<IfModule mod_mime.c>
    # Web fonts
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType application/vnd.ms-fontobject .eot
    AddType font/ttf .ttf
    AddType font/otf .otf
    
    # Images
    AddType image/webp .webp
    AddType image/svg+xml .svg
    
    # Manifests
    AddType application/manifest+json .webmanifest
    AddType text/cache-manifest .appcache
</IfModule>

# === PHP SETTINGS (pokud je povoleno) ===
<IfModule mod_php.c>
    # Skrytí PHP verze
    php_flag expose_php off
    
    # Memory limit pro těžší stránky
    php_value memory_limit 256M
    
    # Časové limity
    php_value max_execution_time 60
    php_value max_input_time 60
    
    # Upload limity
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>

# === ERROR PAGES ===
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# === PERFORMANCE OPTIMIZATIONS ===

# Disable server-side includes
Options -Includes

# Follow symbolic links (může zrychlit server)
Options +FollowSymLinks

# Disable MultiViews (může způsobovat konflikty)
Options -MultiViews

# === CORS (pokud potřebuješ API) ===
<IfModule mod_headers.c>
    SetEnvIf Origin "https://(www\.)?(petr-dubsky\.cz)$" CORS_ORIGIN=$0
    Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, DELETE, PUT"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"
</IfModule>

# === FINAL OPTIMIZATIONS ===

# Remove Last-Modified header
<IfModule mod_headers.c>
    Header unset Last-Modified
</IfModule>

# Add Vary header for better caching
<IfModule mod_headers.c>
    Header always set Vary "Accept-Encoding,User-Agent"
</IfModule>